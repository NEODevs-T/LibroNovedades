@page "/en/FormatGroup/{id:int?}"
@page "/es/FormatoAgrupado/{id:int?}"

@inject LocalizationService LocalizationService
@using System.Globalization
@using LibroNovedades.Services
@inject ITranslationService Translator
@inject IPaisData DataPais;
@inject IEmpresaData DataEmpresa;
@inject IDivisionData DataDivision;
@inject ILineaData LineaData;
@inject IEquipoEAMData EquipoEAMData;
@inject IDataAPI DataAPI;
@inject ILibroNovData LibroNovData;
@inject IDataTiParTP DataTiParTP;
@inject IClasifiTPMData ClasifiTPMData;
@inject ICentroData DataCentro;
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
@inject NavigationManager NavigationManager
@inject ILocalStorageService LocalStorage
@inject NotificationService notificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using LibroNovedades.DTOs
@using LibroNovedades.Resources


@if (IsCargado)
{
    <PageTitle>@Traducciones["Formato"]</PageTitle>

    <BSContainer PaddingBottom="Padding.Large">
        <BSRow>
            <h1 class="titulo">@Traducciones["LibroDeNovedades"]</h1>
        </BSRow>
    </BSContainer>

    <BSCard CardType="CardType.Card" style="width: 90%;" MarginBottom="Margins.Large">
        <BSCard CardType="CardType.Body">
            <BSCard CardType="CardType.Text">

                @* -------------------- BLOQUE: SELECTORES SUPERIORES / LISTADO DE PARADAS -------------------- *@
                @if (!causaCargada)
                {
                    <BSRow>

                        @* País *@
                        @if (isAccesoPais)
                        {
                            <BSCol class="item" Position="Position.Relative" Place ColumnMedium="4">
                                <BSLabel class="labelFormulario">@Traducciones["Pais"]</BSLabel>
                                <BSInput IsDisabled="false" InputType="InputType.Select" @bind-Value="idPais" @onchange="BuscarEmpresas">
                                    @if (listaPais != null)
                                    {
                                        <option value="0">@Traducciones["SeleccioneUnPais"]</option>
                                        @foreach (var item in listaPais)
                                        {
                                            <option value="@item.IdPais">@item.Pnombre</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="0">@Traducciones["Cargando"] ...</option>
                                    }
                                </BSInput>
                            </BSCol>
                        }

                        @* Empresa *@
                        @if (isAccesoEmpresa)
                        {
                            <BSCol class="item" Position="Position.Relative" Place ColumnMedium="4">
                                <BSLabel class="labelFormulario">@Traducciones["Empresas"]</BSLabel>
                                <BSInput IsDisabled="false" InputType="InputType.Select" @bind-Value="idEmpresa" @onchange="BuscarCentros">
                                    @if (listaEmpresa != null)
                                    {
                                        <option value="0">@Traducciones["SeleccioneUnaEmpresa"]</option>
                                        @foreach (var item in listaEmpresa)
                                        {
                                            <option value="@item.IdEmpresa">@item.Empresa</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="0">@Traducciones["Cargando"] ...</option>
                                    }
                                </BSInput>
                            </BSCol>
                        }

                        @* Centro *@
                        @if (isAccesoCentro)
                        {
                            <BSCol class="item" Position="Position.Relative" Place ColumnMedium="4">
                                <BSLabel class="labelFormulario">@Traducciones["Centro"]</BSLabel>
                                <BSInput IsDisabled="false" InputType="InputType.Select" @bind-Value="idCentro" @onchange="BuscarDivisiones">
                                    @if (listaCentro != null)
                                    {
                                        <option value="0">@Traducciones["SeleccioneUnCentro"]</option>
                                        @foreach (var item in listaCentro)
                                        {
                                            <option value="@item.IdCentro">@item.Centro</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="0">@Traducciones["Cargando"] ...</option>
                                    }
                                </BSInput>
                            </BSCol>
                        }

                        @* División *@
                        @if (isAccesoDivision)
                        {
                            <BSCol class="item" Position="Position.Relative" Place ColumnMedium="4">
                                <BSLabel class="labelFormulario">@Traducciones["Divisiones"]</BSLabel>
                                <BSInput IsDisabled="false" InputType="InputType.Select" @bind-Value="idDivision" @onchange="BuscarLinea">
                                    @if (listaDivision != null)
                                    {
                                        <option value="0">@Traducciones["SeleccioneUnaDivision"]</option>
                                        @foreach (var item in listaDivision)
                                        {
                                            <option value="@item.IdDivision">@item.Ndivision</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="0">@Traducciones["Cargando"] ...</option>
                                    }
                                </BSInput>
                            </BSCol>
                        }

                        @* Línea *@
                        <BSCol class="item" Position="Position.Relative" Place ColumnMedium="4">
                            <BSLabel class="labelFormulario">@Traducciones["Linea"]</BSLabel>
                            <BSInput InputType="InputType.Select" @bind-Value="dataNove.IdLinea" @onchange="BuscarTiempoPerdido">
                                @if (idDivision != 0)
                                {
                                    @if (listaLinea != null)
                                    {
                                        <option value="0">@Traducciones["SeleccioneUnaLinea"]</option>
                                        @foreach (var item in listaLinea)
                                        {
                                            <option value="@item.IdLinea">@item.Linea</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="0">@Traducciones["Cargando"] ...</option>
                                    }
                                }
                                else
                                {
                                    <option value="0">@Traducciones["SeleccioneUnaDivision"]</option>
                                }
                            </BSInput>
                        </BSCol>

                        @* Sin pérdida de tiempo (solo se muestra si hay línea) *@
                        <BSCol class="item" Position="Position.Relative" Align="Align.End" AlignRow="OTRAlignRow" Place ColumnMedium="4">
                            @if (dataNove.IdLinea != 0)
                            {
                                <BSButton class="buttonFormularioOK" style="margin-right: 10px;" @onclick="SinPerdida">@Traducciones["SinPerdidaDeTiempo"]</BSButton>
                            }
                        </BSCol>
                    </BSRow>

                    <br />
                    <br />

                    @* ---------- MODO MANUAL (cuando no hay paradas y el rol es Mantenimiento) ---------- *@
                    @if (paradasBandera && rol != null && rol.Contains("Mantenimiento"))
                    {
                        <BSRow>
                            <BSCol Position="Position.Relative" Place ColumnMedium="5">
                                @if (rol.Contains("Mantenimiento"))
                                {
                                    <BSLabel class="labelFormularioGrande">@Traducciones["TiempoEmpleado"]</BSLabel>
                                }
                                else
                                {
                                    <BSLabel class="labelFormularioGrande">@Traducciones["TiempoPerdido"]</BSLabel>
                                }
                                <BSInput InputType="InputType.Number" @bind-Value="tiempoPerdido" min="0" rows="1"></BSInput>
                            </BSCol>

                            <BSCol Position="Position.Relative" Place ColumnMedium="4">
                                <BSLabel class="labelFormulario">@Traducciones["Causa"]</BSLabel>
                                <BSInput InputType="InputType.Select" @bind-Value="dataNove.IdTipoNove">
                                    @if (listaTiposNovedad != null)
                                    {
                                        <option value="0">@Traducciones["Seleccionar"]</option>
                                        @foreach (var item in listaTiposNovedad)
                                        {
                                            var texto = idPais == 5 ? item.Tpenglish : item.Tpnombre;
                                            <option value="@item.IdTiParTp">@texto</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="0">@Traducciones["Cargando"] ...</option>
                                    }
                                </BSInput>
                            </BSCol>

                            <BSCol Position="Position.Relative" Class="AbajoBoton" Place ColumnMedium="3">
                                <BSButton class="buttonFormularioOK" @onclick="eleccionSinGespline">@Traducciones["Seleccionar"]</BSButton>
                            </BSCol>
                        </BSRow>
                    }
                    else
                    {
                        @* ---------- FILTRO + TABLA DE PARADAS (solo si hay línea y hay paradas) ---------- *@
                        @if (dataNove.IdLinea != 0 && !paradasBandera)
                        {
                            @* Filtro arriba (único) *@
                            <BSRow class="mb-2">
                                <BSCol Position="Position.Relative" Place ColumnMedium="6">
                                    <BSInput InputType="InputType.Text"
                                             @bind-Value="filtroParadas"
                                             Placeholder="Filtrar paradas..." />
                                </BSCol>
                            </BSRow>

                            <BSTable IsResponsive="true" IsStriped="true">
                                <BSTHead>
                                    <BSTR class="cabeceraTabla">
                                        <BSTD>#</BSTD>
                                        <BSTD>@Traducciones["Seccion"]</BSTD>
                                        <BSTD>@Traducciones["Descripcion"]</BSTD>
                                        <BSTD>@Traducciones["Tiempo"]</BSTD>
                                        <BSTD>@Traducciones["Seleccionar"]</BSTD>
                                    </BSTR>
                                </BSTHead>

                                <BSTBody class="cuerpoTabla">
                                    @if (paradasVM == null || paradasVM.Count == 0)
                                    {
                                        <BSTR>
                                            <BSTD ColSpan="5">@Traducciones["SeleccioneUnaLinea"]</BSTD>
                                        </BSTR>
                                    }
                                    else
                                    {
                                        // (NO usar "@{ }" aquí; ya estás dentro de un bloque C#)
                                        var listaFiltrada = string.IsNullOrWhiteSpace(filtroParadas)
                                            ? paradasVM
                                            : paradasVM.Where(v =>
                                                   (!string.IsNullOrWhiteSpace(v.Parada.Aparte) &&
                                                    v.Parada.Aparte.Contains(filtroParadas, StringComparison.OrdinalIgnoreCase))
                                                || (!string.IsNullOrWhiteSpace(v.Parada.NombreParada) &&
                                                    v.Parada.NombreParada.Contains(filtroParadas, StringComparison.OrdinalIgnoreCase))
                                                || (!string.IsNullOrWhiteSpace(v.Parada.CodigoParada) &&
                                                    v.Parada.CodigoParada.Contains(filtroParadas, StringComparison.OrdinalIgnoreCase))
                                                || (!string.IsNullOrWhiteSpace(v.Parada.CodigoGrupoParada) &&
                                                    v.Parada.CodigoGrupoParada.Contains(filtroParadas, StringComparison.OrdinalIgnoreCase))
                                               ).ToList();

                                        @if (listaFiltrada.Count == 0)
                                        {
                                            <BSTR>
                                                <BSTD ColSpan="5" class="text-muted">No hay resultados para el filtro.</BSTD>
                                            </BSTR>
                                        }
                                        else
                                        {
                                            @foreach (var vm in listaFiltrada)
                                            {
                                                <BSTR Class="@GetEstadoClase(vm.Estado)">
                                                    <BSTD>@(vm.Index + 1)</BSTD>
                                                    <BSTD>@vm.Parada.Aparte</BSTD>
                                                    <BSTD>@vm.Parada.NombreParada</BSTD>
                                                    <BSTD>@Math.Round(vm.Parada.TiempoPerdido, 2)</BSTD>
                                                    <BSTD>
                                                        @if (vm.Estado == "0")
                                                        {
                                                            <BSButton class="btn btn-primary btn-sm" @onclick="() => eleccion(vm.Index)">
                                                                @Traducciones["Seleccionar"]
                                                            </BSButton>
                                                        }
                                                        else if (vm.Estado == "1")
                                                        {
                                                            <span class="badge bg-success">@Traducciones["Actualizado"]</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning text-dark">@Traducciones["PorActualizar"]</span>
                                                            <BSButton class="btn btn-outline-primary btn-sm ms-2" @onclick="() => eleccion(vm.Index)">
                                                                @Traducciones["Seleccionar"]
                                                            </BSButton>
                                                        }
                                                    </BSTD>
                                                </BSTR>
                                            }
                                        }
                                    }
                                </BSTBody>
                            </BSTable>
                        }
                        else
                        {
                            @* Mientras no haya línea seleccionada o no existan paradas, NO mostramos filtro/tabla *@
                            @if (dataNove.IdLinea == 0)
                            {
                                <div class="text-muted">@Traducciones["SeleccioneUnaLinea"]</div>
                            }
                            else if (paradasBandera)
                            {
                                <div class="text-muted">No hay paradas actuales para la línea seleccionada.</div>
                            }
                        }
                    }
                }
                else
                {
                    @* -------------------- BLOQUE: FORMULARIO DE REGISTRO (causaCargada == true) -------------------- *@
                    <BSForm Model="dataNove" IsRow="true" Gutters="Gutters.Medium" OnSubmit="OK">
                        <DataAnnotationsValidator />

                        @if (isAccesoCentro)
                        {
                            <BSCol Position="Position.Relative" Place ColumnMedium="4">
                                <BSLabel class="labelFormulario">@Traducciones["Centro"]</BSLabel>
                                <BSInput IsDisabled="true" InputType="InputType.Select" @bind-Value="idCentro">
                                    @if (listaCentro != null)
                                    {
                                        <option value="0">@Traducciones["SeleccioneUnCentro"]</option>
                                        @foreach (var item in listaCentro)
                                        {
                                            <option value="@item.IdCentro">@item.Centro</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="0">@Traducciones["Cargando"] ...</option>
                                    }
                                </BSInput>
                            </BSCol>
                        }

                        <BSCol Position="Position.Relative" Place ColumnMedium="4">
                            <BSLabel class="labelFormulario">@Traducciones["Linea"]</BSLabel>
                            <BSInput InputType="InputType.Select" IsDisabled="true" @bind-Value="dataNove.IdLinea" @onchange="BuscarTiempoPerdido">
                                @if (idCentro != 0)
                                {
                                    @if (listaLinea != null)
                                    {
                                        <option value="0">@Traducciones["SeleccioneUnaLinea"]</option>
                                        @foreach (var item in listaLinea)
                                        {
                                            <option value="@item.IdLinea">@item.Linea</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="0">@Traducciones["Cargando"] ...</option>
                                    }
                                }
                                else
                                {
                                    <option value="0">@Traducciones["SeleccioneUnCentro"]</option>
                                }
                            </BSInput>
                            <BSFeedback For="@(() => dataNove.IdLinea)" />
                        </BSCol>

                        <BSCol Position="Position.Relative" Place ColumnMedium="4">
                            <BSLabel class="labelFormulario">@Traducciones["Grupo"]</BSLabel>
                            <RadzenDropDown FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            FilterOperator="StringFilterOperator.StartsWith"
                                            AllowFiltering="true"
                                            TValue="string"
                                            Data="@(grupos.Select(c => c.Value))"
                                            @bind-Value="dataNove.Lngrupo"
                                            Style="width: 100%"
                                            Disabled="@isDisableManualGT">
                            </RadzenDropDown>
                            <BSFeedback For="@(() => dataNove.Lngrupo)" />
                        </BSCol>

                        <BSCol Position="Position.Relative" Place ColumnMedium="4">
                            <BSLabel class="labelFormulario">@Traducciones["Turno"]</BSLabel>
                            <BSInput name="Turno" IsDisabled="@isDisableManualGT" InputType="InputType.Text" rows="5" @bind-Value="dataNove.Lnturno"></BSInput>
                            <BSFeedback For="@(() => dataNove.Lnturno)" />
                        </BSCol>

                        <BSCol Position="Position.Relative" Place ColumnMedium="6">
                            <BSLabel class="labelFormularioGrande">@Traducciones["CodigoEquipo"]</BSLabel>
                            <RadzenDropDown FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            AllowFiltering="true"
                                            TValue="string"
                                            Data="listaEquiposEAM"
                                            LoadData="@LoadData"
                                            ValueProperty="EcodEquiEam"
                                            AllowClear="true"
                                            @bind-Value="dataNove.IdEquipo"
                                            Style="width: 100%">
                                <Template Context="item">
                                    @item.EcodEquiEam - @item.EnombreEam - @item.EdescriEam
                                </Template>
                            </RadzenDropDown>
                        </BSCol>

                        @if (isTPM)
                        {
                            @if (isFichaManual)
                            {
                                <BSCol Position="Position.Relative" Place ColumnMedium="4">
                                    <BSLabel class="labelFormularioGrande">@Traducciones["Ficha"]</BSLabel>
                                    <BSInput InputType="InputType.Text" rows="1" @bind-Value="dataNove.LnfichaRes"></BSInput>
                                    <BSFeedback For="@(() => dataNove.LnfichaRes)" />
                                </BSCol>
                            }

                            <BSCol Position="Position.Relative" Place ColumnMedium="5">
                                <BSLabel class="labelFormulario">@Traducciones["ClasificacionTPM"]</BSLabel>
                                <BSInput IsDisabled="@isDisableManualCTPM" id="TPM" InputType="InputType.Select" @bind-Value="dataNove.IdCtpm">
                                    @if (listaClasificacionTPM != null)
                                    {
                                        <option value="0">@Traducciones["Seleccionar"]</option>
                                        @foreach (var item in listaClasificacionTPM)
                                        {
                                            <option value="@item.IdCtpm">
                                                @Traducciones[ValidationMessages.MapTPMKey(item.Ctpmnom)]
                                            </option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="0">@Traducciones["Cargando"] ...</option>
                                    }
                                </BSInput>
                                <BSFeedback For="@(() => dataNove.IdCtpm)" />
                            </BSCol>

                            <BSCol Position="Position.Relative" Place ColumnMedium="3">
                                <BSLabel style="width: 200px;" class="labelFormulario">@Traducciones["FichaSupervisor"]</BSLabel>
                                <BSInput InputType="InputType.Text" @bind-Value="dataNove.LnfichSupe">
                                </BSInput>
                                <BSFeedback For="@(() => dataNove.LnfichSupe)" />
                            </BSCol>

                            <BSCol Position="Position.Relative" Place ColumnMedium="3">
                                <BSLabel class="labelFormulario">@Traducciones["Resuelto"]</BSLabel>
                                <BSInput InputType="InputType.Select" @bind-Value="dataNove.LnisResu">
                                    <option value="0">@Traducciones["No"]</option>
                                    <option value="1">@Traducciones["Si"]</option>
                                </BSInput>
                                <BSFeedback For="@(() => dataNove.LnisResu)" />
                            </BSCol>
                        }

                        <BSCol Position="Position.Relative" Place ColumnMedium="12">
                            <BSLabel class="labelFormulario">@Traducciones["Discrepancia"]</BSLabel>
                            <BSInput class="TextAreaMediano" placeholder="@nota" InputType="InputType.TextArea" rows="5" @bind-Value="dataNove.Lndiscrepa"></BSInput>
                            <BSFeedback For="@(() => dataNove.Lndiscrepa)" />
                        </BSCol>

                        <BSCol Position="Position.Relative" Place ColumnMedium="12">
                            @if (dataNove.LnisResu == 1)
                            {
                                <BSLabel class="labelFormulario">@Traducciones["Accion"]</BSLabel>
                            }
                            else
                            {
                                <BSLabel class="labelFormulario">@Traducciones["Observacion"]</BSLabel>
                            }
                            <BSInput class="TextAreaMediano" InputType="InputType.TextArea" rows="5" @bind-Value="dataNove.Lnobserv"></BSInput>
                            <BSFeedback For="@(() => dataNove.Lnobserv)" />
                        </BSCol>

                        <BSCol Column="12">
                            <BSButton class="buttonFormularioOK" IsDisabled="@isDisabledButton" IsSubmit="true">@Traducciones["Registrar"]</BSButton>
                            <BSButton class="buttonFormularioDLT" IsDisabled="@isDisabledButton" @onclick="atras" IsReset="true">@Traducciones["Atras"]</BSButton>
                        </BSCol>
                    </BSForm>
                }

            </BSCard>
        </BSCard>
    </BSCard>
}
else
{
    <BSRow class="carga" Justify="Justify.Center">
        <BSCol Column="3">
            <div class="loader"></div>
        </BSCol>
    </BSRow>
}
@code{
[CascadingParameter]
private Task<AuthenticationState>? authenticationState { get; set; }

[Parameter]
public int? id { get; set; }

private bool _showTooltip;
private BSAlert _alertRef;

private string? mensaje { get; set; }  
private string? nota { get; set; }   
private string? rol { get; set; } 
private string? ficha { get; set; } 
public Dictionary<string, string> Traducciones { get; set; } = new();
private LibroNoveDTO dataNove { get; set; } = new LibroNoveDTO();
private List<LibroNoveDTO> listaDataNove { get; set; } = new List<LibroNoveDTO>();
private List<LibroNoveDTO> listaNove { get; set; } = new List<LibroNoveDTO>();
private List<LibroNoveDTO> listaNoveSinTiempoPerdido = new();

private TiParTpDTO tipoParada { get; set; }
private List<List<string>> paradas { get; set; } = new List<List<string>>();
private List<int> indexParadas { get; set; } = new List<int>();

private IEnumerable<Claim> claims { get; set; } = Enumerable.Empty<Claim>();


private int idPais { get; set; }

private int idEmpresa { get; set; }
private int idCentro { get; set; } = 0;
private int idDivision { get; set; }
private int idLinea { get; set; }

private bool isAccesoPais { get; set; }
private bool isAccesoEmpresa { get; set; }
private bool isAccesoCentro { get; set; }
private bool isAccesoDivision { get; set; }
private bool isAccesoLinea { get; set; }
private bool isDisableManualCTPM { get; set; }
private bool isDisableManualGT { get; set; }
private bool isDisabledButton { get; set; }
private bool IsCargado { get; set; }
private bool isTPM { get; set; }
private bool isFichaManual { get; set; }

private List<PaiDTO> listaPais { get; set; } = new();
private List<EmpresasVDTO> listaEmpresa { get; set; } = new();
private List<CentrosVDTO> listaCentro { get; set; } = new();
private List<DivisionesVDTO> listaDivision { get; set; } = new();
private List<LineaVDTO> listaLinea { get; set; } = new();
private List<EquipoEamDTO> listaEquiposEAM { get; set; } = new();
private List<EquipoEamDTO> listaAllEquiposEAM { get; set; } = new();
private List<ClasifiTpmDTO> listaClasificacionTPM { get; set; } = new();
private List<TiParTpDTO> listaTiposNovedad { get; set; } = new();
private List<string> listaTurnoYGrupo { get; set; } = new();
private List<ParadaEstadoVM> paradasVM { get; set; } = new();
private string? filtroParadas { get; set; } = string.Empty;
private RadzenDropDown<string> radzenDropDown { get; set; }

private bool causaCargada { get; set; }
private bool paradasBandera { get; set; }
private bool IsNuevo { get; set; }
private bool bandera { get; set; }

private int tiempoPerdido { get; set; }
private int indexCambio { get; set; }

public (int PAVECA, int CHEMPRO, int PANASA, int PAINSA, int PAPISA, int BIOPACOL, int TTL) empresas =
    (PAVECA: 1, CHEMPRO: 2, PANASA: 3, PAINSA: 4, PAPISA: 5, BIOPACOL: 6, TTL: 7);

public readonly Dictionary<string, string> grupoPAVECA = new()
{
    { "GrupoA", "A" }, { "GrupoB", "B" }, { "GrupoC", "C" }, { "GrupoD", "D" }
};

public readonly Dictionary<string, string> grupoPAINSA = new()
{
    { "Grupo1", "1" }, { "Grupo2", "2" }, { "Grupo3", "3" }, { "Grupo4", "4" }
};

public readonly Dictionary<string, string> grupoPANASA = new()
{
    { "Grupo1", "-" }
};

public readonly Dictionary<string, string> grupoPAPISA = new()
{
    { "GrupoA", "A" }, { "GrupoB", "B" }, { "GrupoC", "C" }
};

public Dictionary<string, string> grupos { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await LocalizationService.EstablecerCulturaDesdeTokenAsync();
        CultureInfo.CurrentCulture = CultureInfo.DefaultThreadCurrentCulture;
        CultureInfo.CurrentUICulture = CultureInfo.DefaultThreadCurrentUICulture;

        var claves = new[]
        {
            "Accion", "Actualizado", "Atras", "CampoVacio", "Cargando", "Causa", "Centro", "ClasificacionTPM", 
