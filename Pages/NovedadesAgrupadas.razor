                dataNove.Lnobserv =  dataNove.Lnobserv.ToLower();
                dataNove.IdMaster = listaLinea.Where(l => l.IdLinea == dataNove.IdLinea).First().IdMaster;
                listaDataNove.Add(dataNove);

                try
                {
                    if(IsNuevo){
                        bandera = await LibroNovData.InsertarRegistro(listaDataNove);
