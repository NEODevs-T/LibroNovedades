    protected async Task BuscarTiempoPerdido(ChangeEventArgs e)
    {
        try
        {
            LineaVDTO linea;
            string temporal;
            List<string> listaDeEstado;
            LibroNoveDTO? dataNov;
            double parada;

            dataNove.IdLinea = int.Parse(e.Value.ToString());
            listaEquiposEAM = await EquipoEAMData.BuscarEquiposSegunLinea(dataNove.IdLinea);
            listaAllEquiposEAM = await EquipoEAMData.BuscarEquiposSegunLinea(dataNove.IdLinea);

            linea = listaLinea.FirstOrDefault(l => l.IdLinea == dataNove.IdLinea);

            listaNove = await LibroNovData.RegistroDeHoyPorLinea(dataNove.IdLinea);

            // ❗ Llamamos al ÚNICO método que tu API expone
            var dtoList = await DataAPI.GetParadasActualesTurnoPorLineaAgrupadas(linea.LcenCos)
                ?? new List<ParadasActualesAgrupadasDTO>();

            // ⚠ Convertimos DTO → List<List<string>> (estructura legacy que tu tabla usa)
            paradas = new List<List<string>>()
            {
                dtoList.Select(x => x.CodigoParada ?? "").ToList(),
                dtoList.Select(x => x.CodigoGrupoParada ?? "").ToList(),
                dtoList.Select(x => x.CodigoParada?.Substring(0,2) ?? "").ToList(),
                dtoList.Select(x => x.NombreParada ?? "").ToList(),
                dtoList.Select(x => x.Aparte ?? "").ToList(),
                dtoList.Select(x => x.TiempoPerdido.ToString()).ToList()
            };

            // Calculamos estados igual que tu código viejo
            listaDeEstado = new List<string>();
            for (int i = 0; i < paradas[0].Count; i++)
            {
                temporal = paradas[0][i] + "-" + paradas[1][i] + "-" + paradas[2][i] + "-"
                        + DateTime.Now.ToString("ddMMyyyy") + "-"
                        + listaTurnoYGrupo[0] + listaTurnoYGrupo[1];

                dataNov = listaNove.FirstOrDefault(n => n.IdParada == temporal);

                if (dataNov == null)
                {
                    listaDeEstado.Add("0");
                    continue;
                }

                parada = Math.Round(double.Parse(paradas[5][i]), 5);

                if (dataNov.LntiePerMi == parada)
                    listaDeEstado.Add("1");
                else
                    listaDeEstado.Add("2");
            }

            paradas.Add(listaDeEstado);

            // Esto no se toca
            if (paradas[0].Count == 0)
            {
                paradasBandera = true;
                indexParadas = new List<int>();
            }
            else
            {
                paradasBandera = false;
                indexParadas = Enumerable.Range(0, paradas[0].Count).ToList();
            }
        }
        catch (Exception ex)
        {
            mensaje = "Error: " + ex.Message;
            Notificacion("error", "", mensaje);
        }
    }

    public async Task eleccion(int item){
        try{
            string temporal;
            LibroNoveDTO data;

            indexCambio = item;
            temporal = paradas[0][item] + "-" + paradas[1][item] + "-" + paradas[2][item] + "-" +  DateTime.Now.ToString("ddMMyyyy") + "-" + listaTurnoYGrupo[0] + listaTurnoYGrupo[1];
            data = await LibroNovData.ObtenerPorIdParada(temporal);

            if(data.IdParada == null){
                tipoParada = await DataTiParTP.ObtenerTipoParadaId(paradas[1][item]);
                dataNove.IdTipoNove = tipoParada.IdTiParTp;
                GrupoTurno();
                dataNove.IdEquipo = "";
                dataNove.Lnobserv = "";
                nota = "Nota: " + paradas[4][item] + " - " + paradas[3][item];
                dataNove.Lndiscrepa = "";
                dataNove.IdParada =  temporal;
                IsNuevo = true;
                dataNove.IdCtpm = 2;
                dataNove.LntiePerMi = Math.Round(double.Parse(paradas[5][item]),5);
            }else{
                dataNove.IdLinea = data.IdLinea;
                dataNove.IdAreaCar = data.IdAreaCar;
                dataNove.IdEquipo = data.IdEquipo;
                dataNove.IdlibrNov =  data.IdlibrNov;
                dataNove.IdParada = data.IdParada;
                dataNove.IdTipoNove = data.IdTipoNove;
                dataNove.Lndiscrepa = data.Lndiscrepa;
                dataNove.Lnfecha = data.Lnfecha;
                dataNove.LnfichaRes = data.LnfichaRes;
                dataNove.Lngrupo = data.Lngrupo;
                dataNove.LnisPizUni = data.LnisPizUni;
                dataNove.Lnobserv = data.Lnobserv;
                dataNove.Lnturno = data.Lnturno;
                dataNove.IdCtpm = data.IdCtpm;
                dataNove.LnisResu = data.LnisResu;
                IsNuevo = false;
                dataNove.LntiePerMi = Math.Round(double.Parse(paradas[5][item]),5);
            }
            causaCargada = true;
        }catch(Exception e){
            mensaje = "Error: " + e.Message;
            Notificacion("error","",mensaje);
        }
    }

