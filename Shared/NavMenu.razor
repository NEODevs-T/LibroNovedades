@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Neo</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@($"{Nav.BaseUri}{homeHref}")" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> @labelHome
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@($"{Nav.BaseUri}{FormatoAgrupadoHref}")">
                <span class="oi oi-pencil" aria-hidden="true"></span> @labelFormat
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@($"{Nav.BaseUri}{historicalHref}")">
                <span class="oi oi-book" aria-hidden="true"></span> @labelHistorical
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@UrlReunion">
                <span class="oi oi-people" aria-hidden="true"></span> @labelMeeting
            </NavLink>
        </div>
    </nav>
</div>



@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private string labelHome = "Inicio";
    private string labelFormat = "Formato";
    private string labelHistorical = "Histórico";
    private string labelMeeting = "Reunión de Turno";
    private string homeHref = "es/inicio";
    private string historicalHref = "es/Historico";
    private string FormatoAgrupadoHref = "es/FormatoAgrupado";
    private const int TrinidadYTobago = 5;

        private string UrlReunion
    {
        get
        {
            return TrinidadYTobago == 5 
                ? "http://neo.paveca.com.ve/ReuniondeTurnoDesarrollo/en/home" 
                : "http://neo.paveca.com.ve/ReuniondeTurnoDesarrollo/es/inicio";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            int.TryParse(user.FindFirst(c => c.Type == "IdPais")?.Value, out int idPais);

            if (idPais == TrinidadYTobago)
            {
                labelHome = "Home";
                labelFormat = "Format";
                labelHistorical = "Historical";
                labelMeeting = "Daily Meeting";
                homeHref = "en/home";
                historicalHref = "en/Historical";
                FormatoAgrupadoHref = "en/FormatGroup";
            }
        }
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    


}

