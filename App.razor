@using LibroNovedades.Services
@inject CultureService CultureService

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    Inicie Sesión.
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>


        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">No se encuentra ninguna página con esa dirección. Por favor selecciona una página indicada en la barra de navegación.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("🔄 App.razor: Inicializando y aplicando cultura...");
        await CultureService.EstablecerCulturaDesdeUsuarioAsync();
    }
}
