    }

    public class ParadaEstadoVM
    {
        public ParadasActualesAgrupadasDTO Parada {get; set; }
        public string Estado {get; set; }
        public int Index {get; set; }
    }

    public static class ParadaIdHelper
    {
        public static string BuildIdParada (ParadasActualesAgrupadasDTO dto, DateTime fecha, string turno, string grupo)
        {
            if
            (string.IsNullOrWhiteSpace(dto.CodigoParada) || dto.CodigoParada.Length < 2)
            throw new ArgumentException("CodigoParada debe tener al menos 2 caracteres.", nameof(dto.CodigoParada));            
            var primerosDos = dto.CodigoParada.Substring(0, 2);
            return $"{dto.CodigoParada}-{dto.CodigoGrupoParada}-{primerosDos}-{fecha:ddMMyyyy}-{turno}{grupo}";
        }
    }


    private string GetEstadoClase(string estado) => estado switch
    {
        "1" => "table-success",
        "2" => "table-warning",
        "0" => "table-light",
        _ => string.Empty
    };



    
protected async Task BuscarTiempoPerdido(ChangeEventArgs e)
{
    try
    {
        if (e?.Value == null)
        {
            Notificacion("error","","Selección invalida.");
            paradasBandera = true;
            paradasVM = new List<ParadaEstadoVM>();
            indexParadas = new List<int>();
            return;
        }

        var idLineaSel = int.Parse(e.Value.ToString());
        dataNove.IdLinea = idLineaSel;

        // Equipos por línea (sin cambios en UI)
        listaAllEquiposEAM = await EquipoEAMData.BuscarEquiposSegunLinea(idLineaSel);
        listaEquiposEAM = listaAllEquiposEAM.ToList();

        // Validar línea
        var linea = listaLinea.FirstOrDefault(l => l.IdLinea == idLineaSel);
        if (linea == null)
        {
            Notificacion("error", "", "La línea seleccionada no existe.");
            paradasBandera = true;
            paradasVM = new List<ParadaEstadoVM>();
            indexParadas = new List<int>();
            return;
        }

        // ⚠️ Usa el mismo parámetro que YA te funciona en la URL:
        var paradasDto = await DataAPI.GetParadasActualesTurnoPorLineaAgrupadas(linea.LcenCos);
        // Si tu endpoint realmente necesita IdMaster, cambia a: linea.IdMaster
        // Si necesita IdLinea, usa: idLineaSel

        // Mostrar listado si hay paradas (SIN depender de turno/grupo ni novedades)
        if (paradasDto != null && paradasDto.Count > 0)
        {
            paradasBandera = false;

            // Creamos el VM únicamente para listar (Estado neutro "0" -> usa tus estilos existentes con GetEstadoClase)
            var vmList = new List<ParadaEstadoVM>(paradasDto.Count);
            for (int i = 0; i < paradasDto.Count; i++)
            {
                vmList.Add(new ParadaEstadoVM
                {
                    Parada = paradasDto[i],
                    Estado = "0",   // no cambia estilos Radzen; tu GetEstadoClase("0") ya mapea a "table-light"
                    Index  = i
                });
            }

            paradasVM = vmList;
            indexParadas = vmList.Select(x => x.Index).ToList();
        }
        else
        {
            paradasBandera = true;
            paradasVM = new List<ParadaEstadoVM>();
            indexParadas = new List<int>();
        }
    }
    catch (Exception ex)
    {
        if (ex.Message.Contains("Response status code does not indicate success: 500 (Internal Server Error)."))
        {
            mensaje = Traducciones["Gespline"];
            Notificacion("error","",mensaje);
        }
        else
        {
            mensaje = "Error: " + ex.Message;
            Notificacion("error","",mensaje);
        }

        paradasBandera = true;
        paradasVM = new List<ParadaEstadoVM>();
        indexParadas = new List<int>();
    }
}

    public async Task eleccion(int item){
        try
        {
            indexCambio = item;
            var dto = paradasVM[item].Parada;
            var turno = listaTurnoYGrupo[0];
            var grupo = listaTurnoYGrupo[1];
            var temporal = 
            ParadaIdHelper.BuildIdParada(dto, DateTime.Now, turno, grupo);
            var data = await LibroNovData.ObtenerPorIdParada(temporal);
            tipoParada = await
            DataTiParTP.ObtenerTipoParadaId(dto.CodigoGrupoParada);
            dataNove.IdTipoNove = tipoParada.IdTiParTp;
            GrupoTurno();
            nota = "Nota: " + dto.Aparte + " - " + dto.NombreParada;
            dataNove.IdParada = temporal;
            var tiempoRedondeado = Math.Round(dto.TiempoPerdido, 5);
            if (data.IdParada == null)
            {
                IsNuevo = true;
                dataNove.IdCtpm = 2;
                dataNove.LntiePerMi = tiempoRedondeado;
                dataNove.IdEquipo = "";
                dataNove.Lnobserv = "";
                dataNove.Lndiscrepa = "";
            }
            else
            {
                IsNuevo = false;
                dataNove.IdLinea = data.IdLinea;
                dataNove.IdAreaCar = data.IdAreaCar;
                dataNove.IdEquipo = data.IdEquipo;
                dataNove.IdlibrNov = data.IdlibrNov;
                dataNove.IdParada = data.IdParada;
                dataNove.IdTipoNove = data.IdTipoNove;
                dataNove.Lndiscrepa = data.Lndiscrepa;
                dataNove.Lnfecha = data.Lnfecha;
                dataNove.LnfichaRes = data.LnfichaRes;
                dataNove.Lngrupo = data.Lngrupo;
                dataNove.LnisPizUni = data.LnisPizUni;
                dataNove.Lnobserv = data.Lnobserv;
                dataNove.Lnturno = data.Lnturno;
                dataNove.IdCtpm = data.IdCtpm;
                dataNove.LnisResu = data.LnisResu;
                dataNove.LntiePerMi = tiempoRedondeado;
            }
            causaCargada = true;
        }
        catch (Exception e)
        {
            mensaje = "Error: " + e.Message;
            Notificacion("error", "", mensaje);
        }
    }

