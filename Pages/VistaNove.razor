@page "/es/Historico"
@page "/en/Historical"

@inject IPaisData DataPais;
@inject IEmpresaData DataEmpresa;
@inject ICentroData DataCentro;
@inject IDivisionData DivisionData;
@inject ILineaData LineaData;
@inject IEquipoEAMData EquipoEAMData;
@inject IDataAPI DataAPI;
@inject ILibroNovData LibroNovData;
@inject IDataTiParTP DataTiParTP;
@inject IClasifiTPMData ClasifiTPMData;
@inject ILogicLibroNov LogicLibroNov;
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
@inject NavigationManager NavigationManager
@inject ILocalStorageService LocalStorage
@inject NotificationService notificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@labelHistorico</PageTitle>
@if(IsCargado){
    <BSContainer PaddingBottom="Padding.Large">
        <BSRow>
            <h1 class="titulo">@labelHistorico</h1>
        </BSRow>
    </BSContainer>

    <BSCard CardType="CardType.Card" style="width: 90%;" MarginBottom="Margins.Large">
            <BSCard CardType="CardType.Body">

                <BSCard CardType="CardType.Text">
                    
                    <BSRow>
                        <BSCol Position="Position.Relative" Place ColumnMedium="3">
                            <BSLabel class="labelFormulario">@labelDesde</BSLabel>
                            <BSInput BSInput InputType="InputType.Date" rows="1" @bind-Value="filtroFechaInicio"></BSInput>
                        </BSCol>
                        <BSCol Position="Position.Relative" Place ColumnMedium="3">
                            <BSLabel class="labelFormulario">@labelHasta</BSLabel>
                            <BSInput BSInput InputType="InputType.Date" rows="1" @bind-Value="filtroFechaFinal"></BSInput>
                        </BSCol>
                    </BSRow>
                    <br>
                    <BSRow>
                        <BSCol class="item" Position="Position.Relative" Place ColumnMedium="5">
                            <BSLabel class="labelFormulario">@labelEstado</BSLabel>
                                <BSInput  InputType="InputType.Select" @bind-Value="filtroIsResuelto">
                                    <option value="2">@labelTodos</option>
                                    <option value="0">@labelSinResolver</option>
                                    <option value="1">@labelResueltos</option>
                                </BSInput>
                        </BSCol>

                        <BSCol class="item" Position="Position.Relative" Place ColumnMedium="5">
                            <BSLabel class="labelFormulario">@labelClasificacionTPM</BSLabel>
                                <BSInput  InputType="InputType.Select" IsDisabled="@IsDisableFTPM" @bind-Value="filtroClasificacionTPM">
                                    <option value="0">@labelTodos</option>
                                    @if (listaClasificacionTPM != null)
                                    {
                                        @foreach (var item in listaClasificacionTPM)
                                        {
                                            <option value="@item.IdCtpm">@TraducirClasificacionTPM(item.Ctpmnom.ToUpper())</option>
                                        }  
                                    }
                                </BSInput>
                        </BSCol>

                        @if(isAccesoPais){
                                <BSCol class="item" Position="Position.Relative" Place ColumnMedium="4">
                                        <BSLabel class="labelFormulario">@labelPais</BSLabel>
                                        <BSInput IsDisabled="false" InputType="InputType.Select" @bind-Value="idPaisFiltro" @onchange="BuscarEmpresas">
                                            <option value="0">@labelSeleccione</option>
                                            @if(listaPais != null){
                                                @foreach (var item in listaPais)
                                                {
                                                    <option value="@item.IdPais">@item.Pnombre</option>
                                                }
                                            }else{
                                                <option value="0">@labelCargando ...</option>
                                            }
                                        </BSInput>
                                </BSCol>
                            }

                            @if(isAccesoEmpresa){
                                <BSCol class="item" Position="Position.Relative" Place ColumnMedium="4">
                                        <BSLabel class="labelFormulario">@labelEmpresas</BSLabel>
                                        <BSInput IsDisabled="false" InputType="InputType.Select" @bind-Value="idEmpresa" @onchange="BuscarCentros">
                                            <option value="0">@labelSeleccione</option>
                                            @if(listaEmpresa != null){
                                                @foreach (var item in listaEmpresa)
                                                {
                                                    <option value="@item.IdEmpresa">@item.Empresa</option>
                                                }
                                            }else{
                                                <option value="0">@labelCargando ...</option>
                                            }
                                        </BSInput>
                                </BSCol>
                            }

                            @if(isAccesoCentro){
                                <BSCol class="item" Position="Position.Relative" Place ColumnMedium="4">
                                        <BSLabel class="labelFormulario">@labelCentro</BSLabel>
                                        <BSInput IsDisabled="false" InputType="InputType.Select" @bind-Value="idCentro" @onchange="BuscarDivisiones">
                                            <option value="0">@labelSeleccione</option>
                                            @if(listaCentro != null){
                                                @foreach (var item in listaCentro)
                                                {
                                                    <option value="@item.IdCentro">@item.Centro</option>
                                                }
                                            }else{
                                                <option value="0">@labelCargando ...</option>
                                            }
                                        </BSInput>
                                </BSCol>
                            }

                            @if(isAccesoDivision){
                                <BSCol class="item" Position="Position.Relative" Place ColumnMedium="4">
                                        <BSLabel class="labelFormulario">@labelDivisiones</BSLabel>
                                        <BSInput IsDisabled="false" InputType="InputType.Select" @bind-Value="idDivision" @onchange="BuscarLinea">
                                            @if(listaDivision != null){
                                                <option value="0">@labelTodos</option>
                                                @foreach (var item in listaDivision)
                                                {
                                                    <option value="@item.IdDivision">@item.Ndivision</option>
                                                }
                                            }else{
                                                <option value="0">@labelCargando ...</option>
                                            }
                                        </BSInput>
                                </BSCol>
                            }

                            <BSCol class="item" Position="Position.Relative" Place ColumnMedium="4">
                                        <BSLabel class="labelFormulario">@labelLinea</BSLabel>
                                        <BSInput InputType="InputType.Select" @bind-Value="filtroLinea">
                                            @if (idDivision != 0)
                                            {   
                                                @if(listaLinea != null){
                                                    <option value="0">@labelTodos</option>
                                                    @foreach (var item in listaLinea)
                                                    {
                                                        <option value="@item.IdLinea">@item.Linea</option>
                                                    }
                                                }else{
                                                    <option value="0">@labelCargando ...</option>
                                                }
                                            }else{
                                                <option value="0">@labelSeleccioneDivision</option>
                                            }
                                        </BSInput>
                            </BSCol>
                        
                    </BSRow> 
                    <br>
                    <BSRow>
                        <BSCol Position="Position.Relative" Place ColumnMedium="4">
                            <BSButton class="buttonFormularioOK" IsDisabled="@isDisabled"  @onclick="buscar">@labelBuscar</BSButton>
                        </BSCol>
                    </BSRow>
                    @if (listaNovedades != null)
                    {
                        <br>
                        <br>
                        <BSTable IsResponsive="true" IsStriped="true">
                            <BSTHead>
                                <BSTR class="cabeceraTabla">
                                    <BSTD>#</BSTD>
                                    <BSTD>@labelLinea</BSTD>
                                    <BSTD>@labelFecha</BSTD>
                                    <BSTD>@labelCodigoEquipo</BSTD>
                                    <BSTD>@labelGrupo</BSTD>
                                    <BSTD>@labelTurno</BSTD>
                                    <BSTD>@labelTiempoPerdido</BSTD>
                                    <BSTD>@labelDiscrepancia</BSTD>
                                    <BSTD>@labelAreaCargador</BSTD>
                                    <BSTD>@labelObservacion</BSTD>
                                    <BSTD>@labelSupervisor</BSTD>
                                    <BSTD>@labelEstado</BSTD>
                                    @if(IsAccesoCambioEstado){
                                        <BSTD>@labelCambioDeEstado</BSTD>
                                    }
                            @* //TODO: ARREGLAR LA Pizarra *@
                                    @if(IsAccesoPizarra){
                                        <BSTD>@labelPizarraUnificada</BSTD>
                                        <BSTD>@labelTipoDeReunion</BSTD>
                                    }
                                </BSTR>
                            </BSTHead>
                            <BSTBody class="cuerpoTabla">
                                @foreach (var item in listaNovedades){
                                    <BSTR>
                                        <BSTD>@(listaNovedades.IndexOf(item) + 1)</BSTD>
                                        <BSTD>@item.Linea</BSTD>
                                        <BSTD>@item.Lnfecha.ToString("dd/MM/yyyy")</BSTD>
                                        <BSTD>@item.IdEquipo.</BSTD>
                                        <BSTD>@item.Lngrupo</BSTD>
                                        <BSTD>@item.Lnturno</BSTD>
                                        @if(item.LntiePerMi == -1){
                                            <BSTD>0</BSTD> 
                                        }else if(item.LntiePerMi.ToString().Count() < 5){
                                            <BSTD>@item.LntiePerMi.ToString().Replace(".",",")</BSTD> 
                                        }else{
                                            <BSTD>@item.LntiePerMi.ToString().Replace(".",",").Substring(0,5)</BSTD> 
                                        }
                                        <BSTD>@item.Lndiscrepa</BSTD>
                                        <BSTD>@item.AreaCarga</BSTD>
                                        <BSTD>@item.Lnobserv</BSTD>
                                            @if(item.LnfichSupe == null)
                                            {
                                                <BSTD> - </BSTD>
                                            } else
                                            {
                                                <BSTD>@item.LnfichSupe</BSTD>
                                            }
                                        
                                        <BSTD>
                                            @if(item.LnisResu == 1){
                                                <p>@labelResuelto</p>
                                            }else if(item.LnisResu == 0){
                                                <p>@labelSinResolver</p>
                                            }else{
                                                <p> - </p>
                                            }
                                        </BSTD>
                                        
                                        @if(IsAccesoCambioEstado){
                                            <BSTD>
                                                @if(item.LnisResu == 1){
                                                    <div>
                                                        <RadzenButton Disabled="@isDisabled" Click=@(() => Edicion(item.IdlibrNov)) class="rz-background-color-white" Image="./icon/Sync.png" ButtonStyle="ButtonStyle.Light" />
                                                        @* <BSButton class="buttonFormularioCambio" IsDisabled="@isDisabled" @onclick=@(() => Edicion(item.IdlibrNov)) IsSubmit="true">Editar</BSButton> *@
                                                    </div>
                                                }else if(item.LnisResu == 0){
                                                    <div>
                                                        <RadzenButton Disabled="@isDisabled" Click=@(() => Edicion(item.IdlibrNov)) class="rz-background-color-white" Image="./icon/Sync.png" ButtonStyle="ButtonStyle.Light" />
                                                        @* <BSButton class="buttonFormularioCambio" IsDisabled="@isDisabled" @onclick=@(() => Edicion(item.IdlibrNov)) IsSubmit="true">Editar</BSButton> *@
                                                    </div>
                                                }else{
                                                    <p> - </p>
                                                }
                                            </BSTD>
                                        }
                                        @if(IsAccesoPizarra){
                                            <BSTD>
                                                <div >
                                                    <BSInputCheckbox Size="Size.ExtraLarge" CheckedValue="true" UnCheckedValue="false" @bind-Value="item.LnisPizUni"/>
                                                </div>
                                            </BSTD>
                                            <BSTD>
                                                <BSInput id="TPM" InputType="InputType.Select" @bind-Value="item.TipoReu" style="border-radius: 2px; box-shadow: 0 0 1px #000; width: auto;">
                                                    <option value="2">@labelTurno</option>
                                                    <option value="1">@labelDiaria</option>
                                                </BSInput>
                                            </BSTD>
                                        }
                                    </BSTR>
                                }
                            </BSTBody>
                        </BSTable>
                        <BSRow>
                            <BSCol Column="12">
                                @if(IsAccesoPizarra){
                                    <BSButton class="buttonFormularioOK" IsDisabled="@isDisabled" @onclick=Guardar IsSubmit="true">@labelRegistrar</BSButton>
                                }
                            </BSCol>
                        </BSRow>
                    }
                
                </BSCard>
        </BSCard>
    </BSCard>
}else{
    <BSRow class="carga" Justify="Justify.Center">
        <BSCol Column="3">
        <div class="loader"></div>
        </BSCol>  
    </BSRow>
}



@code{

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    private DateTime filtroFechaInicio { get; set;}
    private DateTime filtroFechaFinal { get; set;}
    private int filtroTipoNovedad { get; set;} = 0;
    private int filtroIsResuelto { get; set;} = 2;
    private int filtroClasificacionTPM { get; set;}
    private int filtroLinea { get; set;}
    private bool isAccesoPais {get;set;}
    private bool isAccesoEmpresa {get;set;}
    private bool isAccesoCentro {get;set;}
    private bool isAccesoDivision {get;set;}
    private bool isAccesoLinea {get;set;}
    private bool IsAccesoPizarra  { get; set;}
    private bool IsAccesoCambioEstado  { get; set;}
    private bool IsCargado  { get; set;}
    private bool isDisabled  { get; set;}
    private bool band1  { get; set;}
    private bool band2  { get; set;}
    private bool IsDisableFTPM { get; set;}
    private string? rol { get; set;}
    private string mensaje { get; set;}
    private List<PaiDTO> listaPais {get;set;} 
    private List<EmpresasVDTO> listaEmpresa {get;set;}
    private List<CentrosVDTO> listaCentro {get;set;}
    private List<DivisionesVDTO> listaDivision {get;set;}
    private List<LineaVDTO> listaLinea {get;set;}
    private List<LibroNoveDTO> listaNovedades { get; set;}
    private List<TiParTpDTO> listaTiposNovedad { get; set;}
    private List<ClasifiTpmDTO> listaClasificacionTPM { get; set;}
    private LibroNoveDTO dataNove {get; set;}
    private int idPais { get; set; }
    private int idEmpresa { get; set; }
    private int idCentro  { get; set;}
    private int idDivision { get; set; }
    private int idLinea { get; set; }
    private int idAreCargada { get; set;}
    private int tipoReu { get; set;} = 2;
    private BSAlert _alertRef { get; set;}
    private string nombre  { get; set;}
    private string apellido  { get; set;}
    private string labelHistorico = "Histórico";
    private string labelDesde = "Desde";
    private string labelHasta = "Hasta";
    private string labelEstado = "Estado";
    private string labelTodos = "Todos";
    private string labelSinResolver = "Sin resolver";
    private string labelResueltos = "Resueltos";
    private string labelClasificacionTPM = "Clasificación TPM";
    private string labelPais = "País";
    private string labelEmpresas = "Empresas";
    private string labelCentro = "Centro";
    private string labelDivisiones = "Divisiones";
    private string labelLinea = "Línea";
    private string labelBuscar = "Buscar";
    private string labelDiscrepancia = "Discrepancia";
    private string labelFecha = "Fecha";
    private string labelGrupo = "Grupo";
    private string labelTurno = "Turno";
    private string labelTiempoPerdido = "Tiempo Perdido (min)"; 
    private string labelCodigoEquipo = "Código Equipo";     
    private string labelAreaCargador = "Área cargador"; 
    private string labelObservacion = "Observación";        
    private string labelSupervisor = "Supervisor";
    private string labelCambioDeEstado = "Cambio de estado";
    private string labelPizarraUnificada = "Pizarra Unificada";
    private string labelTipoDeReunion = "Tipo de Reunión";
    private string labelRegistrar = "Registrar";
    private string labelCargando = "Cargando";
    private string labelSeleccione = "Seleccione";
    private string labelSeleccioneDivision = "Seleccione una división";
    private string labelResuelto = "Resuelto";
    private string labelDiaria = "Diaria";
    private int idPaisFiltro { get; set; }

    private string TraducirMensaje(string mensaje)
    {
        if (idPais == 5)
        {
            switch (mensaje)
            {
                case "Historico de registro de las novedades":
                    return "Historical record of observations";
                case "Sin Acceso":
                    return "No Access";
                case "Se realizo de manera exitosa":
                    return "Completed successfully";
                case "Falla en la actualizacion en el libro de novedades, la data fue registrada en la pizarra unificada":
                    return "Update failed in the logbook, data was registered on the unified board";
                case "No se encontró ningún dato valido para registrar al libro de novedades. Recuerde que las actividades resueltas no pueden ser enviadas a la Pizarra, además no podrá enviar actividades que ya se cargaron anteriormente.":
                    return "No valid data found to register in the logbook. Remember that resolved activities cannot be sent to the Board, and you cannot send activities that have already been loaded previously.";
                case "Error al consultar al gespline.":
                    return "Error querying gespline.";
                case "El cambio fue exitoso":
                    return "The change was successful";
                case "Intente de Nuevo. Si el problema persiste enviar un correo a Mejora Continua":
                    return "Try again. If the problem persists, send an email to Continuous Improvement";
                case "La discrepancia de las novedades ya cumplió 24 horas, no se puede cambiar el estado de esta novedad":
                    return "The discrepancy of the observations has already reached 24 hours, the status of this observation cannot be changed";
                default:
                    return mensaje;
            }
        }
        return mensaje;
    }
    
    protected override async Task  OnInitializedAsync()
    {
        IsCargado = false;
        if (authenticationState is not null){
            AuthenticationState? authState = await authenticationState;
            ClaimsPrincipal? user = authState?.User;
            if (user?.Identity is not null && user.Identity.IsAuthenticated)
            {
                idPais = int.Parse(user.FindFirst(c => c.Type == "IdPais")?.Value ?? "0") ;
                idPaisFiltro = idPais;
                if (idPais == 5)
                {
                    labelHistorico = "Historical";
                    labelDesde = "From";
                    labelHasta = "To";
                    labelEstado = "Status";
                    labelTodos = "All";
                    labelSinResolver = "Unresolved";
                    labelResueltos = "Resolved";
                    labelClasificacionTPM = "TPM Classification";
                    labelPais = "Country";
                    labelEmpresas = "Companies";
                    labelCentro = "Center";
                    labelDivisiones = "Divisions";
                    labelLinea = "Line";
                    labelBuscar = "Search";
                    labelDiscrepancia = "Discrepancy";
                    labelFecha = "Date";
                    labelGrupo = "Group";
                    labelTurno = "Shift";
                    labelTiempoPerdido = "Lost Time (min)";
                    labelCodigoEquipo = "Equipment Code";
                    labelAreaCargador = "Loader Area";
                    labelObservacion = "Observation";
                    labelSupervisor = "Supervisor";
                    labelPizarraUnificada = "Unified Board";
                    labelCambioDeEstado = "Change Status";
                    labelTipoDeReunion = "Meeting Type";
                    labelRegistrar = "Register";
                    labelCargando = "Loading";
                    labelSeleccione = "Select";
                    labelSeleccioneDivision = "Select a division";
                    labelResuelto = "Resolved";
                    labelDiaria = "Daily";
                    labelCargando = "Loading";
                }
                mensaje = "Historico de registro de las novedades";
                Notificacion("info","",mensaje);
                isDisabled = false;
                idAreCargada = 0;
                IsAccesoPizarra = false;
                IsAccesoCambioEstado = false;
                IsDisableFTPM = true;
                filtroFechaInicio = DateTime.Now.Date;
                filtroFechaFinal = DateTime.Now.Date;
                rol = user.FindFirst(c => c.Type.Contains("role"))?.Value ?? "";
                nombre = user.FindFirst(c => c.Type.Contains("givenname"))?.Value ?? "";
                apellido = user.FindFirst(c => c.Type.Contains("surname"))?.Value ?? "";
                idCentro = int.Parse(user.FindFirst(c => c.Type == "IdCentro")?.Value ?? "0");
                idPais = int.Parse(user.FindFirst(c => c.Type == "IdPais")?.Value ?? "0") ;
                idDivision = int.Parse(user.FindFirst(c => c.Type == "IdDivision")?.Value ?? "0") ;
                idEmpresa = int.Parse(user.FindFirst(c => c.Type == "IdEmpresa")?.Value ?? "0") ;
                isAccesoPais = false;
                isAccesoEmpresa = false;
                isAccesoCentro = false;
                isAccesoDivision = false;
                isAccesoLinea = false;

                listaTiposNovedad = await DataTiParTP.ObtenerTodosTiposNovedad();
                listaClasificacionTPM = await ClasifiTPMData.ObtenerClasificacion();

                if(rol.Contains("SuperAdmin")){
                    isAccesoPais = true;
                    isAccesoEmpresa = true;
                    isAccesoCentro = true;
                    isAccesoDivision = true;
                    isAccesoLinea = true;
                    IsAccesoPizarra = true;
                    IsAccesoCambioEstado = true;
                    
                    // Todos los paises con todas las empresas centros, divisiones y lineas
                    listaPais = await DataPais.ObtenerTodosLosPaises();
                    listaEmpresa = await DataEmpresa.ObtenerEmpresasPorPaies(idPais);
                    listaCentro = await DataCentro.ObtenerCentrosPorEmpresa(idEmpresa);
                    listaDivision = await DivisionData.ObtenerDivisionDelCentro(idCentro);
                    listaLinea = await LineaData.ObtenerLasLineasPorDivision(idDivision);

                }else if(rol.Contains("SuperUser")){
                    isAccesoPais = true;
                    isAccesoEmpresa = true;
                    isAccesoCentro = true;
                    isAccesoDivision = true;
                    isAccesoLinea = true;
                    IsAccesoPizarra = true;
                    IsAccesoCambioEstado = true;
                    
                    // Todos los paises con todas las empresas centros, divisiones y lineas
                    listaPais = await DataPais.ObtenerTodosLosPaises();
                    listaEmpresa = await DataEmpresa.ObtenerEmpresasPorPaies(idPais);
                    listaCentro = await DataCentro.ObtenerCentrosPorEmpresa(idEmpresa);
                    listaDivision = await DivisionData.ObtenerDivisionDelCentro(idCentro);
                    listaLinea = await LineaData.ObtenerLasLineasPorDivision(idDivision);

                }else if(rol.Contains("UserPais")){
                    isAccesoEmpresa = true;
                    isAccesoCentro = true;
                    isAccesoDivision = true;
                    isAccesoLinea = true;
                    IsAccesoCambioEstado = true;
                    if(rol.Contains("Operaciones")){
                        IsAccesoPizarra = true;
                    }

                    // Todas las empresas de ese pais con sus centros, divisiones y lineas
                    listaEmpresa = await DataEmpresa.ObtenerEmpresasPorPaies(idPais);
                    listaCentro = await DataCentro.ObtenerCentrosPorEmpresa(idEmpresa);
                    listaDivision = await DivisionData.ObtenerDivisionDelCentro(idCentro);
                    listaLinea = await LineaData.ObtenerLasLineasPorDivision(idDivision);
                }else if(rol.Contains("UserEmpresa")){
                    isAccesoCentro = true;
                    isAccesoDivision = true;
                    isAccesoLinea = true;
                    IsAccesoCambioEstado = true;
                    if(rol.Contains("Operaciones")){
                        IsAccesoPizarra = true;
                    }

                    // todos los centros,divisiones y lineas de esa empresa
                    listaCentro = await DataCentro.ObtenerCentrosPorEmpresa(idEmpresa);
                    listaDivision = await DivisionData.ObtenerDivisionDelCentro(idCentro);
                    listaLinea = await LineaData.ObtenerLasLineasPorDivision(idDivision);
                }else if(rol.Contains("UserCentro")){ 
                    isAccesoDivision = true;
                    isAccesoLinea = true;
                    IsAccesoCambioEstado = true;
                    if(rol.Contains("Operaciones")){
                        IsAccesoPizarra = true;
                    }
                    // todas las divisiones y lineas de ese centro
                    listaDivision = await DivisionData.ObtenerDivisionDelCentro(idCentro);
                    listaLinea = await LineaData.ObtenerLasLineasPorDivision(idDivision);
                }else if(rol.Contains("UserDivision")){
                    isAccesoLinea = true;
                    // todas las lineas de esa division
                    if(idPais == 1){
                        isAccesoDivision = true;
                        listaDivision = await DivisionData.ObtenerDivisionDelCentro(idCentro);
                    }

                    listaLinea = await LineaData.ObtenerLasLineasPorDivision(idDivision);
                }
                if(rol.Contains("Calidad")){
                    idAreCargada = 2;
                    filtroClasificacionTPM = 4;
                }else if(rol.Contains("Seguridad")){
                    idAreCargada = 3;
                    filtroClasificacionTPM = 1;
                }else if(rol.Contains("Mantenimiento")){
                    idAreCargada = 4;
                    filtroClasificacionTPM = 3;
                }else if(rol.Contains("Operaciones")){
                    idAreCargada = 1;
                    IsDisableFTPM = false;
                }else if(rol.Contains("Admin") || rol.Contains("Super")){
                    IsDisableFTPM = false;
                    idAreCargada = 10;
                }
            }else{
                mensaje = "Sin Acceso";
                Notificacion("info","",mensaje);
            }
        }
        IsCargado = true;
    }

    private string TraducirClasificacionTPM(string nombre)
    {
    if (idPais == 5)
    {
        switch (nombre.ToUpper())
        {
            case "MANTENIMIENTO DE CALIDAD":
                return "QUEALITY MAINTENANCE";
            case "MANTENIMIENTO AUTONOMO":
                return "AUTONOMOUS MAINTENANCE";
            case "SEGURIDAD":
                return "SAFETY";
            case "MANTENIMIENTO ESPECIALIZADO":
                return "SPECIALIZED MAINTENANCE";
            case "NOVEDAD":
                return "OBSERVATION";
            default:
                return nombre;
        }
    }
    return nombre;
    }

